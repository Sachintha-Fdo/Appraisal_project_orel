# Docker Hub image to run (docker-compose.yml): <namespace>/orel-server:<tag>
DOCKERHUB_NAMESPACE=
IMAGE_TAG=latest
# Port on the server (host side of the port mapping)
OREL_PORT=8080

PII_MASTER_KEY_HEX=
REDIS_URL=
USE_FAKE_REDIS=false
PII_REDIS_TTL_SECONDS=604800

API_KEYS=
LOG_LEVEL=INFO

POSTGRES_USER=appraisal
POSTGRES_PASSWORD=
POSTGRES_DB=appraisal
DATABASE_URL=
AUDIT_RETENTION_DAYS=30

AZURE_CALLBACK_TOKEN=
AZURE_REQUEST_TIMEOUT_SECONDS=300
AZURE_MAX_ATTEMPTS=2
AZURE_RETRY_BACKOFF_SECONDS=2
AZURE_RETRY_STATUS_CODES=502,503,504

FAILED_QUEUE_KEY=failed_requests
FAILED_QUEUE_MAX_LEN=5000

ECHO_AZURE=false

PUBLIC_BASE_URL=
SAMPLE_IMAGES_PATH=sample_images
UPLOADS_DIR=uploads
MASKED_PDFS_DIR=masked_pdfs
VENDOR_EXCHANGE_DIR=vendor_exchanges
PRESIDIO_LANGUAGE=en
PRESIDIO_SPACY_MODEL=en_core_web_sm

PDF_OCR_ZOOM=4
PDF_MASK_TIMEOUT_SECONDS=600
JSON_MASK_KEYS=

POSTGRES_PASSWORD_URLENC=
